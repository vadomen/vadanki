{
  "name": "vadanki",
  "version": "1.0.0",
  "description": "AnkiWeb-style spaced-repetition flashcard app with Gemini AI",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "playwright": "^1.60.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {}
  }
}
